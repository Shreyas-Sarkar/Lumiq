SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required by the current client; comma-separated keys.
LLM_API_KEYS=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
UPLOAD_DIR=./data/uploads
# Optional metadata retrieval (Qdrant + Cohere).
QDRANT_URL=
QDRANT_API_KEY=
COHERE_API_KEY=
MAX_FILE_SIZE_MB=50
EXECUTION_TIMEOUT_SECONDS=10
MAX_RETRY_COUNT=2

