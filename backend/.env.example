SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq key(s); quota is shared within an organization, not multiplied per key.
LLM_API_KEYS=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
UPLOAD_DIR=./data/uploads
# Apply both SQL migrations and verify the private bucket before enabling.
INVESTIGATIONS_ENABLED=false
LEGACY_EXECUTION_ENABLED=false
DATASET_BUCKET=lumiq-datasets
MAX_FILE_SIZE_MB=5
ALLOWED_ORIGINS=http://localhost:3000
# Conservative app ceilings. Set them from actual project/org quotas.
GEMINI_RPM=2
GEMINI_RPD=20
GEMINI_TPM=12000
GROQ_RPM=5
GROQ_RPD=50
GROQ_TPM=12000
# Optional historical retrieval/execution; new investigations do not use them.
QDRANT_URL=
QDRANT_API_KEY=
COHERE_API_KEY=
EXECUTION_TIMEOUT_SECONDS=10
MAX_RETRY_COUNT=2
